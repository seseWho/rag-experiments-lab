# Local development environment variables for LLM connectivity.
# Replace placeholder values with real credentials in your environment.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=replace_me
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=replace_me
